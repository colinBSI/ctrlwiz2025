<?xml version="1.0" encoding="utf-8"?>
<RibbonControl
    x:Uid="CustomRibbonTab"
    xmlns="clr-namespace:Autodesk.Windows;assembly=AdWindows"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >
    <RibbonTab Id="ID_CustomTab_1" Title="CtrlWiz" >
        <RibbonPanel x:Uid="RibbonPanel_1" >
            <RibbonPanelSource x:Uid="RibbonPanelSource_RibbonPanel_1" KeyTip="C1" Title="XBox Controller" >
                <RibbonButton x:Uid="Button_1" Id="ID_Button_1" Size="Large" ShowText="True" Orientation="Vertical" />
                <RibbonButton x:Uid="Button_2" Id="ID_Button_2" Size="Large" ShowText="True" Orientation="Vertical" />
                <RibbonButton x:Uid="Button_3" Id="ID_Button_3" Size="Large" ShowText="True" Orientation="Vertical" />
                <RibbonButton x:Uid="Button_4" Id="ID_Button_4" Size="Large" ShowText="True" Orientation="Vertical" />
                <RibbonButton x:Uid="Button_5" Id="ID_Button_5" Size="Large" ShowText="True" Orientation="Vertical" />
            </RibbonPanelSource>
        </RibbonPanel>
    </RibbonTab>
</RibbonControl>
